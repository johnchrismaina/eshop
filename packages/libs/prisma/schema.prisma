generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model images {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  file_id String
  url     String

  productId String?   @db.ObjectId
  product   products? @relation("ProductImages", fields: [productId], references: [id])
}

enum Role {
  user
  admin
}

model users {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String            @unique
  password      String?
  role          Role              @default(user)
  following     String[]
  avatar        String? // just store avatar URL directly
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  shopReviews   shopReviews[]     @relation("UserReview")
  followedShops userFollowsShop[] // relation: one user can follow many shops
  addresses     address[] // relation: one user can have many addresses
  orders        orders[] // ✅ relation: one user has many orders
}

model admins {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  role      Role     @default(admin)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum addressType {
  Home
  Work
  Other
}

model address {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     addressType
  name      String
  street    String
  city      String
  zip       String
  country   String
  isDefault Boolean     @default(true)
  createdAt DateTime    @default(now())
  // updatedAt DateTime @updatedAt
}

model shopReviews {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userID    String?  @db.ObjectId
  rating    Float
  reviews   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shopsId   String?  @db.ObjectId
  user      users?   @relation("UserReview", fields: [userID], references: [id])
  shops     shops?   @relation("ShopReview", fields: [shopsId], references: [id])
}

model userFollowsShop {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String
  shopId String

  user users @relation(fields: [userId], references: [id])
  shop shops @relation(fields: [shopId], references: [id])
}

model orders {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  user              users       @relation(fields: [userId], references: [id])
  shopId            String
  total             Float
  couponCode        String?
  discountAmount    Float?
  status            String
  deliveryStatus    String      @default("Ordered")
  shippingAddressId String?
  shop              shops       @relation(fields: [shopId], references: [id])
  items             orderItem[] // ✅ relation: one order has many items
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model shops {
  // id          String   @id @map("_id") @default(auto()) @db.ObjectId
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  bio           String?
  category      String
  avatar        String? // store shop logo/banner URL directly
  coverBanner   String?
  address       String
  opening_hours String?
  website       String?
  socialLinks   Json[]
  ratings       Float         @default(0)
  reviews       shopReviews[] @relation("ShopReview")
  sellerId      String        @unique @db.ObjectId
  seller        sellers       @relation("SellerShop", fields: [sellerId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  products      products[]    @relation("ShopProducts") // one-to-many products

  orders    orders[]
  followers userFollowsShop[]
}

model sellers {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  phone_number String
  country      String
  password     String
  stripeId     String?
  shop         shops?   @relation("SellerShop")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model site_config {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  categories    String[]
  subCategories Json
}

model discount_codes {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  public_name   String
  discountType  String
  discountValue Float
  discountCode  String   @unique
  sellerId      String   @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum productStatus {
  Active
  Pending
  Draft
}

model products {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  title                 String
  slug                  String        @unique
  category              String
  subCategory           String
  short_description     String
  detailed_description  String
  video_url             String?
  tags                  String[]
  brand                 String?
  colors                String[]
  sizes                 String[]
  starting_date         DateTime?
  ending_date           DateTime?
  stock                 Int
  sale_price            Float
  regular_price         Float
  ratings               Float         @default(5)
  warranty              String?
  custom_specifications Json?
  customProperties      Json
  isDeleted             Boolean?      @default(false)
  cashOnDelivery        String?
  discount_codes        String[]      @db.ObjectId
  status                productStatus @default(Active)
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  shopId String   @db.ObjectId
  Shop   shops    @relation("ShopProducts", fields: [shopId], references: [id])
  images images[] @relation("ProductImages") // one-to-many gallery

  // New field for sales tracking
  totalSales Int @default(0)
}

// Define an embedded type for actions
type ActionEntry {
  productId String?
  shopId    String?
  action    String
  timestamp DateTime
}

model userAnalytics {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  userId      String        @unique @db.ObjectId // rename from userID to userId and make unique
  lastVisited DateTime?
  actions     ActionEntry[] // new embedded array of action entries

  // Optional enrichment fields you referenced in code
  country String?
  city    String?
  device  String?
}

model productAnalytics {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  productId    String    @unique @db.ObjectId // make this unique so upsert can use it
  shopId       String?   @db.ObjectId
  lastViewedAt DateTime?

  // Counters used in your service
  views        Int @default(0)
  cartAdds     Int @default(0)
  wishlistAdds Int @default(0)
  purchases    Int @default(0)
}

enum ReceiverType {
  SELLER
  ADMIN
  CUSTOMER
}

enum NotificationStatus {
  UNREAD
  READ
}

model orderItem {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String
  order           orders @relation(fields: [orderId], references: [id])
  productId       String
  quantity        Int
  price           Float
  selectedOptions Json? // ✅ store options as JSON (safe for arrays/objects)
}

model notifications {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  message       String
  creatorId     String
  receiverId    String
  receiverType  ReceiverType
  redirect_link String
  status        NotificationStatus @default(UNREAD)
  createdAt     DateTime           @default(now())
}
