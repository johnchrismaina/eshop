{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "out-tsc/packages",
    "rootDir": ".",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": ["libs/**/*.ts", "middleware/**/*.ts", "utils/**/*.ts"],
  "exclude": ["out-tsc", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
