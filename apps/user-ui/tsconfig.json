{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "next", "react", "react-dom"],
    "jsx": "preserve",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@eshop/utils": ["../../packages/utils"],
      "@eshop/utils/*": ["../../packages/utils/*"],
      "@packages/*": ["../../packages/*"]
    },
    "outDir": "dist",
    "rootDir": "../../",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "../../apps/user-ui/.next/types/**/*.ts",
    "../../dist/apps/user-ui/.next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx",
    "../../global.d.ts",
    "src",
    "declarations.d.ts"
, "../seller-ui/src/app/api/categories"  ],
  "exclude": [
    "out-tsc",
    "dist",
    "node_modules",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    ".next"
  ],
  "references": [
    {
      "path": "../../packages",
      "@packages/*": ["packages/*"]
    }
  ]
}
